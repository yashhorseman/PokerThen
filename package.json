{
  "name": "pokerthen",
  "private": true,
  "version": "0.1.0",
  "description": "PokerThen: private play-money Texas Hold'em tables (PokerNow-style) with verifiable server shuffles",
  "type": "module",
  "engines": { "node": ">=22" },
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/run.mjs",
    "start": "node dist/app/server.cjs",
    "pack:zip": "node scripts/deploy-zip.mjs",
    "verify-hand": "tsx scripts/verify-hand.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.24.2",
    "puppeteer-core": "^23.11.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
